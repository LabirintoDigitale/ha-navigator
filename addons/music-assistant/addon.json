{
  "id": "music-assistant",
  "name": "Music Assistant",
  "version": "1.6",
  "author": "Navigator",
  "description": "Musica da Music Assistant: copertina e titolo del brano, play, stop, brano successivo e l'elenco da cui scegliere una playlist o una radio (con una radio il tasto successivo passa alla radio dopo). Per suonare su questo telefono Navigator tiene aperta in sottofondo la pagina di Music Assistant (la trova da solo), così il lettore Web resta disponibile.",
  "settings": [
    {
      "key": "player",
      "label": "Lettore (Music Assistant)",
      "type": "entity",
      "domain": "media_player",
      "integration": "music_assistant"
    },
    {
      "key": "ma_url",
      "label": "Indirizzo di Music Assistant (vuoto = da solo)",
      "type": "text"
    }
  ],
  "window": {
    "title": "🎵 Musica",
    "image": "entity:{player}",
    "caption": "media",
    "width": 220,
    "height": 220,
    "views": [
      "2d",
      "3d"
    ],
    "click": "none",
    "buttons": [
      {
        "icon": "play",
        "label": "Play",
        "service": "media_player.media_play",
        "data": {
          "entity_id": "{player}"
        }
      },
      {
        "icon": "stop",
        "label": "Stop",
        "service": "media_player.media_stop",
        "data": {
          "entity_id": "{player}"
        }
      },
      {
        "icon": "next",
        "label": "Successivo",
        "service": "media_player.media_next_track",
        "data": {
          "entity_id": "{player}"
        },
        "cycle": "next"
      },
      {
        "icon": "playlist",
        "label": "Playlist e radio",
        "list": {
          "browse": "{player}",
          "tabs": [
            {
              "label": "Playlist",
              "path": [
                "Playlists"
              ],
              "exclude": [
                "filesystem"
              ]
            },
            {
              "label": "Radio",
              "path": [
                "Radio"
              ],
              "cycle": true
            }
          ]
        }
      }
    ]
  },
  "background": "{ma_url}"
}
