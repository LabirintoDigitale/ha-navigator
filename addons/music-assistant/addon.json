{
  "id": "music-assistant",
  "name": "Music Assistant",
  "version": "1.1",
  "author": "Navigator",
  "description": "Musica da Music Assistant (o da un altro lettore di Home Assistant): copertina e titolo del brano, play, stop, brano successivo e l'elenco delle playlist da scegliere. Il lettore si sceglie qui sotto.",
  "settings": [
    {
      "key": "player",
      "label": "Lettore (Music Assistant)",
      "type": "entity",
      "domain": "media_player"
    }
  ],
  "window": {
    "title": "🎵 Musica",
    "image": "entity:{player}",
    "caption": "media",
    "width": 220,
    "height": 220,
    "views": [
      "2d",
      "3d"
    ],
    "click": "none",
    "buttons": [
      {
        "icon": "play",
        "label": "Play",
        "service": "media_player.media_play",
        "data": {
          "entity_id": "{player}"
        }
      },
      {
        "icon": "stop",
        "label": "Stop",
        "service": "media_player.media_stop",
        "data": {
          "entity_id": "{player}"
        }
      },
      {
        "icon": "next",
        "label": "Brano successivo",
        "service": "media_player.media_next_track",
        "data": {
          "entity_id": "{player}"
        }
      },
      {
        "icon": "playlist",
        "label": "Playlist",
        "list": {
          "browse": "{player}",
          "path": [
            "Playlists"
          ]
        }
      }
    ]
  }
}
